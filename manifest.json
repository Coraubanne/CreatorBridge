{
  "manifestVersion": 5,
  "id": "fr.clipflow.premiere.bridge",
  "name": "Creator Bridge",
  "shortname": "Creator Bridge",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "clipflowBridge",
      "label": { "default": "Creator Bridge" },
      "minimumSize": { "width": 220, "height": 110 },
      "maximumSize": { "width": 900, "height": 500 },
      "preferredDockedSize": { "width": 280, "height": 140 },
      "preferredFloatingSize": { "width": 320, "height": 160 }
    }
  ]
}
