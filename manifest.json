{
  "manifestVersion": 5,
  "id": "fr.clipflow.premiere.bridge",
  "name": "Creator Bridge",
  "shortname": "Creator Bridge",
  "version": "1.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": ["https://api.github.com"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "clipflowBridge",
      "label": { "default": "Creator Bridge" },
      "minimumSize": { "width": 220, "height": 175 },
      "maximumSize": { "width": 900, "height": 500 },
      "preferredDockedSize": { "width": 290, "height": 200 },
      "preferredFloatingSize": { "width": 320, "height": 220 }
    }
  ]
}
